---
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";

export interface Props {
  title: string;
  description: string;
  tag: string;
}

const { title, description, tag } = Astro.props as Props;
---

<div>
  <div class="ml-[auto] mr-[auto] w-full max-w-[65em] pl-[2rem] pr-[2rem]">
    <Nav />
  </div>
  <div
    class="text-center ml-[auto] mr-[auto] w-full max-w-[65em] pl-[2rem] pr-[2rem]"
  >
    <h1
      class="text-3xl uppercase font-extrabold tracking-tight leading-none text-gray-900 md:text-5xl lg:text-6xl dark:text-white font-pathway-gothic-one m-5 text-center"
    >
      {title} : {description}
    </h1>
  </div>
  <div class="ml-[auto] mr-[auto] w-full max-w-[65em] pl-[2rem] pr-[2rem]">
    <script
      src="https://product-gallery.cloudinary.com/all.js"
      type="text/javascript"
      is:inline></script>
    <div id="my-gallery"></div>

    <script define:vars={{ tag }} type="text/javascript">
      (function init() {
        if (typeof window?.cloudinary !== "undefined") {
          window.myGallery = cloudinary.galleryWidget({
            container: "#my-gallery",
            cloudName: "chipchop",
            mediaAssets: [{ tag: tag, mediaType: "image" }],
            zoom: false,
            fullscreen: true,
            carouselLocation: "left", // This is your change from 'bottom'
            themeProps: {
              primary: "#FFFFFF",
              onPrimary: "#929292",
              active: "#000000",
            },
            thumbnailProps: {
              width: 120,
              height: 80,
              spacing: 1,
              navigationColor: "white",
              navigation: false, // Disable thumbnail navigation arrows
            },
            viewportBreakpoints: [
              {
                breakpoint: 600,
                carouselStyle: "indicators",
              },
            ],
          });

          // Render the gallery
          window.myGallery.render();

          // Inject toggle button for fullscreen thumbnails
          const toggleBtn = document.createElement("button");
          toggleBtn.id = "gallery-toggle-btn";
          toggleBtn.title = "Toggle Thumbnails";
          toggleBtn.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
          `;
          toggleBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            const gallery = document.getElementById("my-gallery");
            if (gallery) {
              gallery.classList.toggle("show-thumbs");
            }
          });

          const galleryEl = document.getElementById("my-gallery");
          if (galleryEl) {
            galleryEl.appendChild(toggleBtn);

            // Inject exit fullscreen button
            const exitBtn = document.createElement("button");
            exitBtn.id = "gallery-exit-btn";
            exitBtn.title = "Exit Fullscreen";
            exitBtn.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            `;
            exitBtn.addEventListener("click", (e) => {
              e.stopPropagation();
              if (document.exitFullscreen) {
                document.exitFullscreen();
              } else if (document.webkitExitFullscreen) {
                document.webkitExitFullscreen();
              } else if (document.msExitFullscreen) {
                document.msExitFullscreen();
              }
            });
            galleryEl.appendChild(exitBtn);
          }

          // --- ADD THIS NEW CODE ---
          const galleryContainer = document.getElementById("my-gallery");
          if (galleryContainer) {
            // Use event delegation to handle clicks on the main image wrapper
            // This ensures it works even when the widget replaces the image elements (e.g. on slide change)
            galleryContainer.addEventListener("click", (e) => {
              const mainMediaWrapper = e.target.closest("button.assetWrapper");

              if (mainMediaWrapper) {
                // Check if we are already in fullscreen
                if (document.fullscreenElement) {
                  // Exit fullscreen
                  if (document.exitFullscreen) {
                    document.exitFullscreen();
                  } else if (document.webkitExitFullscreen) {
                    /* Safari */
                    document.webkitExitFullscreen();
                  } else if (document.msExitFullscreen) {
                    /* IE11 */
                    document.msExitFullscreen();
                  }
                } else {
                  // Enter fullscreen
                  if (galleryContainer.requestFullscreen) {
                    galleryContainer.requestFullscreen();
                  } else if (galleryContainer.webkitRequestFullscreen) {
                    /* Safari */
                    galleryContainer.webkitRequestFullscreen();
                  } else if (galleryContainer.msRequestFullscreen) {
                    /* IE11 */
                    galleryContainer.msRequestFullscreen();
                  }
                }
              }
            });

            // Also add a MutationObserver to ensure the cursor style is applied to new elements
            const observer = new MutationObserver((mutations) => {
              const mainMediaWrapper = galleryContainer.querySelector(
                "button.assetWrapper",
              );
              if (mainMediaWrapper) {
                mainMediaWrapper.style.cursor = "pointer";
              }
            });

            observer.observe(galleryContainer, {
              childList: true,
              subtree: true,
            });
          }
          // --- END OF NEW CODE ---
        } else {
          setTimeout(() => init(), 100);
        }
      })();

      document.addEventListener(
        "astro:after-swap",
        () => {
          if (typeof window.myGallery !== "undefined") {
            window.myGallery.destroy();
          }
        },
        { once: true },
      );
    </script>
  </div>
  <div
    class="text-center ml-[auto] mr-[auto] w-full max-w-[65em] pl-[2rem] pr-[2rem] pt-[2rem]"
  >
    <a
      href="/projects"
      class="inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white bg-slate-700 rounded-lg hover:bg-slate-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        height="1em"
        fill="currentColor"
        viewBox="0 0 448 384"
        class="pr-[5px]"
      >
        <path
          d="M 9 169 Q 0 179 0 192 L 0 192 Q 0 205 9 215 L 169 375 Q 179 384 192 384 Q 205 384 215 375 Q 224 365 224 352 Q 224 339 215 329 L 109 224 L 416 224 Q 430 224 439 215 Q 448 206 448 192 Q 448 178 439 169 Q 430 160 416 160 L 109 160 L 215 55 Q 224 45 224 32 Q 224 19 215 9 Q 205 0 192 0 Q 179 0 169 9 L 9 169 L 9 169 Z"
        ></path>
      </svg>
      Back to projects
    </a>
  </div>
  <Footer />
  <style>
    #my-gallery {
      width: 100vw;
      max-width: 100vw;
      position: relative;
      left: 50%;
      transform: translateX(-50%);
    }

    /* Toggle Button Styles */
    :global(#gallery-toggle-btn) {
      display: none;
      position: fixed;
      top: 20px;
      left: 20px;
      z-index: 2147483647;
      background: rgba(0, 0, 0, 0.5);
      color: white;
      border: 2px solid rgba(255, 255, 255, 0.7);
      border-radius: 50%;
      padding: 12px;
      cursor: pointer;
      animation: pulse 2s infinite;
      transition: background 0.3s;
    }

    :global(#gallery-toggle-btn:hover) {
      background: rgba(0, 0, 0, 0.8);
    }

    @keyframes pulse {
      0% {
        box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
      }
      70% {
        box-shadow: 0 0 0 10px rgba(255, 255, 255, 0);
      }
      100% {
        box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
      }
    }

    /* Show button in fullscreen */
    :global(#my-gallery:fullscreen) :global(#gallery-toggle-btn),
    :global(#my-gallery:-webkit-full-screen) :global(#gallery-toggle-btn),
    :global(#my-gallery:-ms-fullscreen) :global(#gallery-toggle-btn),
    :global(#my-gallery:fullscreen) :global(#gallery-exit-btn),
    :global(#my-gallery:-webkit-full-screen) :global(#gallery-exit-btn),
    :global(#my-gallery:-ms-fullscreen) :global(#gallery-exit-btn),
    :global(#my-gallery:-ms-fullscreen) :global(#gallery-exit-btn) {
      display: block;
    }

    /* Exit Button Styles */
    :global(#gallery-exit-btn) {
      display: none;
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 2147483647;
      background: rgba(0, 0, 0, 0.5);
      color: white;
      border: 2px solid rgba(255, 255, 255, 0.7);
      border-radius: 50%;
      padding: 10px;
      cursor: pointer;
      transition: background 0.3s;
    }

    :global(#gallery-exit-btn:hover) {
      background: rgba(0, 0, 0, 0.8);
    }

    /* Hide thumbnails in fullscreen (default, unless .show-thumbs is present) */
    :global(
        #my-gallery:fullscreen:not(.show-thumbs)
          [data-test="gallery-thumbnail-wrap"]
      ),
    :global(
        #my-gallery:-webkit-full-screen:not(.show-thumbs)
          [data-test="gallery-thumbnail-wrap"]
      ),
    :global(
        #my-gallery:-ms-fullscreen:not(.show-thumbs)
          [data-test="gallery-thumbnail-wrap"]
      ) {
      display: none !important;
    }

    /* Make viewer full width in fullscreen (default, unless .show-thumbs is present) */
    :global(
        #my-gallery:fullscreen:not(.show-thumbs)
          [data-test="gallery-viewer-wrap"]
      ),
    :global(
        #my-gallery:-webkit-full-screen:not(.show-thumbs)
          [data-test="gallery-viewer-wrap"]
      ),
    :global(
        #my-gallery:-ms-fullscreen:not(.show-thumbs)
          [data-test="gallery-viewer-wrap"]
      ) {
      width: 100% !important;
      max-width: 100% !important;
      flex-basis: 100% !important;
      /* Removed overflow-y: auto from here to prevent layout issues */
    }

    /* Allow scrolling in the main container when in fullscreen */
    :global(#my-gallery:fullscreen),
    :global(#my-gallery:-webkit-full-screen),
    :global(#my-gallery:-ms-fullscreen) {
      overflow-y: auto !important;
      overflow-x: hidden !important; /* Prevent horizontal scrolling/overlap */
      height: 100% !important;
      /* Removed display: flex and flex-direction: column as it might cause stacking issues */
      display: block !important;
    }

    /* Ensure the viewer wrap takes full height/width but doesn't force stacking */
    :global(#my-gallery:fullscreen [data-test="gallery-viewer-wrap"]),
    :global(#my-gallery:-webkit-full-screen [data-test="gallery-viewer-wrap"]),
    :global(#my-gallery:-ms-fullscreen [data-test="gallery-viewer-wrap"]) {
      height: 100% !important;
    }

    /* Hide thumbnail navigation arrows (fallback) */
    :global([data-test="gallery-thumbnail-navigation-button"]),
    :global(.cloudinary-thumbnails-navigation) {
      display: none !important;
    }

    /* Force 100% width on viewer elements when NOT in fullscreen to fix layout breakage */
    :global(#my-gallery:not(:fullscreen) [data-test="gallery-viewer-wrap"]),
    :global(
        #my-gallery:not(:-webkit-full-screen) [data-test="gallery-viewer-wrap"]
      ),
    :global(
        #my-gallery:not(:-ms-fullscreen) [data-test="gallery-viewer-wrap"]
      ) {
      width: 100% !important;
      max-width: 100% !important;
    }

    :global(#my-gallery:not(:fullscreen) button.assetWrapper),
    :global(#my-gallery:not(:-webkit-full-screen) button.assetWrapper),
    :global(#my-gallery:not(:-ms-fullscreen) button.assetWrapper) {
      width: 100% !important;
      max-width: 100% !important;
    }
  </style>
</div>
